        self.set_border_width(12)
        self.original = path.read_bytes()
        self.text = self.original.decode('utf-8')
        ET.fromstring(self.text)
        self.pending = {}
        self.start_pending = {}
        self.loading = False
        self.custom = custom_styles()
        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        self.add(outer)
        top = Gtk.Box(spacing=8)
        outer.pack_start(top, False, False, 0)
        top.pack_start(Gtk.Label(label='Preset:'), False, False, 0)
        self.category = Gtk.ComboBoxText()
        for category in ['All', *COLLECTIONS, 'Custom']:
            self.category.append_text(category)
        self.category.set_active(0)
        self.category.connect('changed', self.on_category)
        top.pack_start(self.category, False, False, 0)
        self.presets = Gtk.ComboBoxText()
        self.refresh_presets()
        self.presets.connect('changed', self.on_preset)
        top.pack_start(self.presets, True, True, 0)
        self.section = Gtk.ComboBoxText()
        for s in STYLES + ['Start Button']:
            self.section.append_text(s)
        self.section.set_active(0)
        self.section.connect('changed', self.on_section)
        top.pack_start(self.section, False, False, 0)
        main_area = Gtk.Paned(orientation=Gtk.Orientation.HORIZONTAL)
        main_area.set_position(425)
        outer.pack_start(main_area, True, True, 0)
        scroller = Gtk.ScrolledWindow()
        main_area.pack1(scroller, resize=True, shrink=False)
        self.grid = Gtk.Grid(column_spacing=16, row_spacing=12, margin=12)
        scroller.add(self.grid)
        preview_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8, margin=8)
        main_area.pack2(preview_box, resize=True, shrink=False)
        preview_header = Gtk.Box(spacing=8)
        preview_box.pack_start(preview_header, False, False, 0)
        preview_header.pack_start(Gtk.Label(label='Preview:'), False, False, 0)
        self.preview_mode = Gtk.ComboBoxText()
        self.preview_mode.append_text('Full desktop')
        self.preview_mode.append_text('Selected component')
        self.preview_mode.set_active(0)
        self.preview_mode.connect('changed', lambda *_: self.preview.queue_draw())
        preview_header.pack_start(self.preview_mode, True, True, 0)
        self.preview = Gtk.DrawingArea()
        self.preview.set_size_request(340, 340)
        self.preview.connect('draw', self.draw_preview)
        preview_box.pack_start(self.preview, True, True, 0)
        note = Gtk.Label(label='Preview: configured button images when available; built-in JWM glyphs are approximated.', xalign=0)
        note.get_style_context().add_class('dim-label')
        preview_box.pack_start(note, False, False, 0)
        self.status = Gtk.Label(xalign=0)
        outer.pack_start(self.status, False, False, 0)
        bottom = Gtk.Box(spacing=8)
        outer.pack_start(bottom, False, False, 0)
        reset = Gtk.Button(label='Discard changes')
        reset.connect('clicked', self.on_reset)
        bottom.pack_start(reset, False, False, 0)
        bottom.pack_end(self.make_button('Apply and restart JWM', self.on_apply), False, False, 0)
        bottom.pack_end(self.make_button('Save style…', self.on_save_style), False, False, 0)
        bottom.pack_end(self.make_button('Delete style', self.on_delete_style), False, False, 0)
        bottom.pack_end(self.make_button('Rename style…', self.on_rename_style), False, False, 0)
        self.detect_preset()
        self.on_section()

    def visible_presets(self):
        category = self.category.get_active_text() or 'All'
        builtin = [name for name in PRESETS if category in ('All', PRESET_METADATA[name]['category'])]
        custom = list(self.custom) if category in ('All', 'Custom') else []
        return ['Custom (current configuration)', *builtin, *custom]

    def on_category(self, *_):
        if not hasattr(self, 'presets'):
            return
        self.loading = True
        self.refresh_presets()
        self.loading = False
        self.on_section()

    def refresh_presets(self, selected=None):
        self.custom = custom_styles()
        self.presets.remove_all()
        choices = self.visible_presets()
        for name in choices:
            self.presets.append_text(name)
        self.presets.set_active(choices.index(selected) if selected in choices else 0)

    def detect_preset(self):
        actual = flatten(property_values(self.text))
        for name in [*PRESETS, *self.custom]:
            values = preset_values(name) if name in PRESETS else self.custom[name][0]
            target = flatten(values)
            if target and all(actual.get(k) == v for k, v in target.items()):
                category = PRESET_METADATA[name]['category'] if name in PRESETS else 'Custom'
                self.loading = True
                self.category.set_active(['All', *COLLECTIONS, 'Custom'].index(category))
                self.refresh_presets(name)
                self.loading = False
                self.on_section()
                return

    def make_button(self, label, callback):
        b = Gtk.Button(label=label)
        b.connect('clicked', callback)
        return b

    def fields(self, section):
        fields = [('Foreground',), ('Background',)]
        if section in ('WindowStyle', 'TrayStyle', 'MenuStyle'):
            fields += [('Font',), ('Opacity',)]
        if section == 'WindowStyle':
            fields += [('Width',), ('Corner',)]
        if section == 'PagerStyle':
            fields += [('Text',)]
        if section in ('WindowStyle', 'TaskListStyle', 'PagerStyle', 'MenuStyle'):
            fields += [('Active', 'Foreground'), ('Active', 'Background')]
        if section == 'TaskListStyle':
            fields += [('Minimized', 'Foreground'), ('Minimized', 'Background')]
        return fields

    def current(self, section, path):
        return self.pending.get((section, path), get_value(self.text, section, path))

    def on_section(self, *_):
        self.loading = True
        for child in self.grid.get_children():
            self.grid.remove(child)
        section = self.section.get_active_text()
        if section == 'Start Button':
            try:
                attrs = start_attributes(self.text)
            except ValueError as exc:
                attrs = None
                self.status.set_text(str(exc))
            if attrs is None:
                self.grid.attach(Gtk.Label(label='No unambiguous root-menu TrayButton found.', xalign=0), 0, 0, 2, 1)
            else:
                for i, key in enumerate(('label', 'icon', 'tooltip')):
                    self.grid.attach(Gtk.Label(label=key.title(), xalign=0), 0, i, 1, 1)
                    entry = Gtk.Entry()
                    entry.set_text(self.start_pending.get(key, attrs.get(key, '')))
                    entry.connect('changed', self.on_start_entry, key)
                    self.grid.attach(entry, 1, i, 1, 1)
            self.grid.show_all()
            self.loading = False
            self.update_status()
            self.preview.queue_draw()
            return
        for i, path in enumerate(self.fields(section)):
            key = (section, tuple(path))
            label = Gtk.Label(label=' '.join(path), xalign=0)
            self.grid.attach(label, 0, i, 1, 1)
            value = self.current(section, tuple(path))
            if path[-1] in ('Foreground', 'Background', 'Text'):
                chooser = Gtk.ColorButton()
                rgba = Gdk.RGBA()
                rgba.parse(value if value and rgba.parse(value) else '#808080')
                chooser.set_rgba(rgba)
                chooser.set_use_alpha(False)
                chooser.connect('color-set', self.on_color, key)
                self.grid.attach(chooser, 1, i, 1, 1)
            else:
                entry = Gtk.Entry()
                entry.set_text(value or '')
                entry.connect('changed', self.on_entry, key)
                self.grid.attach(entry, 1, i, 1, 1)
        self.grid.show_all()
        self.loading = False
        self.update_status()
        self.preview.queue_draw()

    def on_start_entry(self, entry, key):
        if self.loading:
            return
        value = entry.get_text()
        try:
            original = (start_attributes(self.text) or {}).get(key, '')
        except ValueError:
            return
        if value != original:
            self.start_pending[key] = value
        else:
            self.start_pending.pop(key, None)
        self.update_status()
        self.preview.queue_draw()

    def on_color(self, button, key):
        if not self.loading:
            c = button.get_rgba()
            self.pending[key] = '#%02X%02X%02X' % (round(c.red*255), round(c.green*255), round(c.blue*255))
            self.update_status()
            self.preview.queue_draw()

    def on_entry(self, entry, key):
        if not self.loading:
            value = entry.get_text().strip()
            if value:
                self.pending[key] = value
            else:
                self.pending.pop(key, None)
            self.update_status()
            self.preview.queue_draw()

    def on_preset(self, *_):
        if self.loading:
            return
        name = self.presets.get_active_text()
        self.pending.clear()
        self.start_pending.clear()
        if name in PRESETS:
            values = preset_values(name)
        elif name in self.custom:
            values = self.custom[name][0]
        else:
            values = {}
        actual = flatten(property_values(self.text))
        self.pending.update({k: v for k, v in flatten(values).items() if actual.get(k) != v})
        self.on_section()

    def update_status(self):
        self.status.set_text(f'{self.path}  •  {len(self.pending) + len(self.start_pending)} pending properties')

    def on_reset(self, *_):
        self.pending.clear()
        self.start_pending.clear()
        self.presets.set_active(0)
        self.on_section()

    def error(self, msg):
        dialog = Gtk.MessageDialog(transient_for=self, flags=0, message_type=Gtk.MessageType.ERROR,
                                   buttons=Gtk.ButtonsType.CLOSE, text='Could not save JWM configuration')
        dialog.format_secondary_text(str(msg))
        dialog.run()
        dialog.destroy()

    def write(self):
        if not self.pending and not self.start_pending:
            return True
        try:
            if self.path.read_bytes() != self.original:
                raise ValueError('The configuration changed on disk. Reopen the editor to avoid overwriting it.')
            text = self.text
            for (section, prop), value in sorted(self.pending.items()):
                text = update_style(text, section, prop, value)
            for key, value in self.start_pending.items():
                text = update_start_attribute(text, key, value)
            ET.fromstring(text)
            if text == self.text:
                self.pending.clear()
                return True
            backup = self.path.with_name(self.path.name + '.bak')
            shutil.copy2(self.path, backup)
            save_atomic(self.path, text.encode('utf-8'))
            self.text = text
            self.original = text.encode('utf-8')
            self.pending.clear()
            self.start_pending.clear()
            self.refresh_presets()
            self.detect_preset()
            self.on_section()
            return True
        except Exception as e:
            self.error(e)
            return False

    def on_save_style(self, *_):
        dialog = Gtk.Dialog(title='Save custom style', transient_for=self, flags=0)
        dialog.add_buttons('Cancel', Gtk.ResponseType.CANCEL, 'Save style', Gtk.ResponseType.OK)
        area = dialog.get_content_area()
        area.set_spacing(8)
        area.set_border_width(12)
        area.pack_start(Gtk.Label(label='Style name:', xalign=0), False, False, 0)
        entry = Gtk.Entry()
        current_name = self.presets.get_active_text()
        if current_name in self.custom:
            entry.set_text(current_name)
        area.pack_start(entry, False, False, 0)
        dialog.show_all()
        response = dialog.run()
        name = entry.get_text().strip()
        dialog.destroy()
        if response != Gtk.ResponseType.OK:
            return
        if not name or '/' in name or '\\' in name or name in PRESETS or name == 'Custom (current configuration)':
            self.error('Choose a nonempty unique style name without path separators.')
            return
        try:
            values = property_values(self.text)
            for (section, path), value in self.pending.items():
                set_nested(values, section, path, value)
            CUSTOM_DIR.mkdir(parents=True, exist_ok=True)
            filename = re.sub(r'[^a-zA-Z0-9_-]+', '-', name).strip('-') or 'style'
            target = self.custom[name][1] if name in self.custom else CUSTOM_DIR / (filename + '.json')
            if target.exists() and name not in self.custom:
                raise ValueError('A style file with this filename already exists.')
            if target.exists():
                confirm = Gtk.MessageDialog(transient_for=self, message_type=Gtk.MessageType.QUESTION,
                                            buttons=Gtk.ButtonsType.YES_NO, text=f'Replace saved style "{name}"?')
                response = confirm.run()
                confirm.destroy()
                if response != Gtk.ResponseType.YES:
                    return
            payload = json.dumps({'name': name, 'category': 'Custom', 'description': '', 'values': values}, indent=2, ensure_ascii=False) + '\n'
            if target.exists():
                save_atomic(target, payload.encode('utf-8'))
            else:
                target.write_text(payload, encoding='utf-8')
            self.loading = True
            self.category.set_active(0)
            self.refresh_presets(name)
            self.loading = False
            self.update_status()
        except Exception as e:
            self.error(e)

    def on_rename_style(self, *_):
        name = self.presets.get_active_text()
        if name not in self.custom:
            self.error('Select a saved custom style to rename.')
            return
        dialog = Gtk.Dialog(title='Rename style', transient_for=self, flags=0)
        dialog.add_buttons('Cancel', Gtk.ResponseType.CANCEL, 'Rename', Gtk.ResponseType.OK)
        entry = Gtk.Entry()
        entry.set_text(name)
        entry.set_margin_top(12)
        entry.set_margin_bottom(12)
        dialog.get_content_area().pack_start(entry, False, False, 0)
        dialog.show_all()
        response = dialog.run()
        new_name = entry.get_text().strip()
        dialog.destroy()
        if response != Gtk.ResponseType.OK or new_name == name:
            return
        if not new_name or '/' in new_name or '\\' in new_name or new_name in PRESETS or new_name in self.custom:
            self.error('Choose a unique style name without path separators.')
            return
        try:
            old_path = self.custom[name][1]
            data = {'name': new_name, 'category': 'Custom', 'description': '', 'values': self.custom[name][0]}
            new_file = re.sub(r'[^a-zA-Z0-9_-]+', '-', new_name).strip('-') or 'style'
            new_path = CUSTOM_DIR / (new_file + '.json')
            if new_path.exists():
                raise ValueError('A style file with this name already exists.')
            new_path.write_text(json.dumps(data, indent=2, ensure_ascii=False) + '\n', encoding='utf-8')
            old_path.unlink()
            self.loading = True
            self.category.set_active(0)
            self.refresh_presets(new_name)
            self.loading = False
            self.on_section()
        except Exception as e:
            self.error(e)

    def on_delete_style(self, *_):
        name = self.presets.get_active_text()
        if name not in self.custom:
            self.error('Select a saved custom style to delete.')
            return
        dialog = Gtk.MessageDialog(transient_for=self, message_type=Gtk.MessageType.QUESTION,
                                   buttons=Gtk.ButtonsType.YES_NO, text=f'Delete saved style "{name}"?')
        answer = dialog.run()
        dialog.destroy()
        if answer == Gtk.ResponseType.YES:
            try:
                self.custom[name][1].unlink()
                self.loading = True
                self.refresh_presets()
                self.loading = False
                self.on_section()
            except Exception as e:
                self.error(e)

    def draw_preview(self, widget, cr):
        import math
        width = widget.get_allocated_width()
        height = widget.get_allocated_height()
        section = self.section.get_active_text()
        selected_only = self.preview_mode.get_active() == 1

        def color(value, fallback):
            rgba = Gdk.RGBA()
            if not rgba.parse(value or fallback):
                rgba.parse(fallback)
            return (rgba.red, rgba.green, rgba.blue)

        def paint(hexcolor):
            cr.set_source_rgb(*color(hexcolor, '#808080'))

        def rect(x, y, w, h, bg):
            paint(bg)
            cr.rectangle(x, y, max(w, 0), max(h, 0))
            cr.fill()

        def text(x, y, value, fg, size=12):
            paint(fg)
            cr.select_font_face('Sans', 0, 0)
            cr.set_font_size(size)
            cr.move_to(x, y)
            cr.show_text(value)

        def v(s, *path, fallback=None):
            return self.current(s, tuple(path)) or fallback

        def relief(x, y, w, h, bg, raised=True):
            rect(x, y, w, h, bg)
            cr.save()
            cr.set_line_width(2)
            # Independent top/left and bottom/right paths; never connect opposite corners.
            cr.new_path()
            cr.move_to(x + w - 1, y + 1)
            cr.line_to(x + 1, y + 1)
            cr.line_to(x + 1, y + h - 1)
            cr.set_source_rgba(1, 1, 1, .40 if raised else .15)
            cr.stroke()
            cr.new_path()
            cr.move_to(x + w - 1, y + 1)
            cr.line_to(x + w - 1, y + h - 1)
            cr.line_to(x + 1, y + h - 1)
            cr.set_source_rgba(0, 0, 0, .55 if raised else .70)
            cr.stroke()
            cr.restore()

        images = title_button_images(self.text, self.path)

        def button_image(key, x, y, w, h, active):
            path = images.get(key + 'Active') if active else None
            path = path or images.get(key)
            if not path:
                return False
            try:
                pix = GdkPixbuf.Pixbuf.new_from_file(path)
                ratio = min((w - 3) / pix.get_width(), (h - 3) / pix.get_height(), 1.0)
                pw, ph = max(1, int(pix.get_width() * ratio)), max(1, int(pix.get_height() * ratio))
                if pw != pix.get_width() or ph != pix.get_height():
                    pix = pix.scale_simple(pw, ph, GdkPixbuf.InterpType.BILINEAR)
                cr.save()
                Gdk.cairo_set_source_pixbuf(cr, pix, x + (w-pw)/2, y + (h-ph)/2)
                cr.rectangle(x + (w-pw)/2, y + (h-ph)/2, pw, ph)
                cr.fill()
                cr.restore()
                return True
            except (GLib.Error, ValueError):
                return False

        def window(x, y, w, h, active):
            bg = v('WindowStyle', 'Active', 'Background', fallback='#D09A52') if active else v('WindowStyle', 'Background', fallback='#B8B6AF')
            fg = v('WindowStyle', 'Active', 'Foreground', fallback='#202124') if active else v('WindowStyle', 'Foreground', fallback='#202124')
            relief(x, y, w, h, bg)
            rect(x+5, y+26, w-10, h-31, '#25272B' if active else '#484B4D')
            text(x+12, y+19, 'Active window' if active else 'Inactive window', fg)
            for i, (glyph, image_key) in enumerate([('_', 'ButtonMin'), ('□', 'ButtonMax'), ('×', 'ButtonClose')]):
                bx = x+w-69+i*21
                relief(bx, y+4, 19, 18, bg)
                if not button_image(image_key, bx, y+4, 19, 18, active):
                    text(bx+5, y+16, '-' if glyph == '_' else ('+' if glyph == '□' else 'x'), fg, 11)
            if active:
                text(x+16, y+54, 'luciano@devuan:~$', '#E5E1D8', 11)

        def tray(x, y, w, h):
            bg = v('TrayStyle', 'Background', fallback='#35383B')
            fg = v('TrayStyle', 'Foreground', fallback='#E5E1D8')
            relief(x, y, w, h, bg)
            start = start_attributes(self.text) or {}
            text(x+10, y+23, self.start_pending.get('label', start.get('label', 'Menu')) or 'Menu', fg)
            for i, name in enumerate(['Terminal', 'Firefox']):
                active = i == 0
                bx = x+62+i*90
                bbg = v('TaskListStyle', 'Active', 'Background', fallback='#D09A52') if active else v('TaskListStyle', 'Background', fallback='#35383B')
                bfg = v('TaskListStyle', 'Active', 'Foreground', fallback='#202124') if active else v('TaskListStyle', 'Foreground', fallback='#E5E1D8')
                relief(bx, y+5, 84, 27, bbg, not active)
                text(bx+5, y+23, name, bfg, 11)

        def menu(x, y):
            bg = v('MenuStyle', 'Background', fallback='#35383B')
            fg = v('MenuStyle', 'Foreground', fallback='#E5E1D8')
            abg = v('MenuStyle', 'Active', 'Background', fallback='#D09A52')
            afg = v('MenuStyle', 'Active', 'Foreground', fallback='#202124')
            relief(x, y, 152, 111, bg)
            for i, label in enumerate(['Applications', 'Terminal', 'Settings', 'Exit']):
                if i == 1:
                    rect(x+5, y+7+i*25, 142, 24, abg)
                text(x+12, y+24+i*25, label, afg if i == 1 else fg, 12)

        def pager(x, y):
            bg = v('PagerStyle', 'Background', fallback='#35383B')
            fg = v('PagerStyle', 'Text', fallback='#E5E1D8')
            abg = v('PagerStyle', 'Active', 'Background', fallback='#202124')
            rect(x, y, 156, 47, bg)
            for i in range(4):
                relief(x+4+i*38, y+6, 35, 35, abg if i == 0 else bg, i != 0)
                text(x+17+i*38, y+29, str(i+1), fg, 11)

        rect(0, 0, width, height, '#292B2E')
        scale = min(width / 470, height / 400)
        cr.save()
        cr.translate((width-470*scale)/2, (height-400*scale)/2)
        cr.scale(scale, scale)
        if not selected_only or section == 'WindowStyle':
            window(20, 18, 355, 156, True)
            window(85, 185, 355, 116, False)
        if not selected_only or section == 'MenuStyle':
            menu(285 if not selected_only else 155, 80 if not selected_only else 35)
        if not selected_only or section == 'PopupStyle':
            bg = v('PopupStyle', 'Background', fallback='#B8B6AF')
            fg = v('PopupStyle', 'Foreground', fallback='#202124')
            relief(24, 313 if not selected_only else 45, 160, 34, bg)
            text(34, 335 if not selected_only else 67, 'Sample tooltip', fg, 12)
        if not selected_only or section in ('TrayStyle', 'TaskListStyle', 'Start Button'):
            tray(12, 357 if not selected_only else 50, 446, 38)
        if not selected_only or section == 'PagerStyle':
            pager(296 if not selected_only else 150, 305 if not selected_only else 50)
        cr.restore()
        return False

    def on_apply(self, *_):
        if self.write():
            try:
                result = subprocess.run(['jwm', '-restart'], capture_output=True, text=True, timeout=10)
                if result.returncode:
                    raise RuntimeError(result.stderr or f'jwm exited with {result.returncode}')
            except Exception as e:
                self.error(f'Configuration saved, but restart failed: {e}')


def main():
    path = Path(sys.argv[1]).expanduser() if len(sys.argv) > 1 else Path.home() / '.jwmrc'
    if not path.is_file():
        sys.exit(f'File not found: {path}')
    try:
        app = Editor(path)
    except Exception as e:
        sys.exit(str(e))
    app.connect('destroy', Gtk.main_quit)
    app.show_all()
    Gtk.main()

if __name__ == '__main__':
    main()

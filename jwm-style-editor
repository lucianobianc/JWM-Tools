PRESET_METADATA = {}

def readable_text(hex_color):
    rgb = [int(hex_color[i:i+2], 16) / 255 for i in (1, 3, 5)]
    luminance = sum(c * weight for c, weight in zip(rgb, (0.2126, 0.7152, 0.0722)))
    return '#202124' if luminance > 0.57 else '#FFFFFF'

for category, items in COLLECTIONS.items():
    for name, swatches in items.items():
        PRESET_METADATA[name] = {'category': category,
                                 'description': 'Inspired palette' if category == 'Heritage' else category}
        if swatches is None:
            continue
        dark, base, accent, muted, light = swatches.split()
        PRESETS[name] = {'base': base, 'text': readable_text(base),
                         'accent': accent, 'accent_text': readable_text(accent),
                         'muted': muted, 'dark': dark}

def preset_values(name):
    p = PRESETS[name]
    result = {}
    for section in STYLES:
        result[section] = {'Foreground': p['text'], 'Background': p['base']}
    result['WindowStyle'].update(Foreground=p['dark'], Background=p['muted'], Width='4', Corner='0')
    result['WindowStyle']['Active'] = {'Foreground': p['accent_text'], 'Background': p['accent']}
    result['TrayStyle']['Font'] = 'Sans-12'
    result['TaskListStyle']['Active'] = {'Foreground': p['accent_text'], 'Background': p['accent']}
    result['TaskListStyle']['Minimized'] = {'Foreground': p['muted'], 'Background': p['dark']}
    result['PagerStyle'] = {'Foreground': p['muted'], 'Background': p['base'], 'Text': p['text'], 'Active': {'Foreground': p['accent'], 'Background': p['dark']}}
    result['MenuStyle']['Active'] = {'Foreground': p['accent_text'], 'Background': p['accent']}
    result['PopupStyle'] = {'Foreground': p['dark'], 'Background': p['muted']}
    return result

CUSTOM_DIR = Path(os.environ.get('XDG_CONFIG_HOME', str(Path.home() / '.config'))) / 'jwm-style-editor' / 'styles'

def custom_styles():
    result = {}
    if CUSTOM_DIR.is_dir():
        for file in sorted(CUSTOM_DIR.glob('*.json')):
            try:
                obj = json.loads(file.read_text(encoding='utf-8'))
                if isinstance(obj, dict) and isinstance(obj.get('name'), str) and isinstance(obj.get('values'), dict):
                    result[obj['name']] = (obj['values'], file)
            except (OSError, ValueError, TypeError):
                pass
    return result

def property_values(text):
    root = ET.fromstring(text)
    result = {}
    for section in STYLES:
        node = root.find(section)
        if node is None:
            continue
        values = {}
        for child in node:
            if child.tag in ('Active', 'Minimized'):
                values[child.tag] = {sub.tag: (sub.text or '').strip() for sub in child if len(sub) == 0 and (sub.text or '').strip()}
            elif len(child) == 0 and (child.text or '').strip():
                values[child.tag] = (child.text or '').strip()
        result[section] = values
    return result

def flatten(values):
    result = {}
    for section, fields in values.items():
        if section not in STYLES or not isinstance(fields, dict):
            continue
        for key, value in fields.items():
            if isinstance(value, dict):
                for subkey, subval in value.items():
                    if isinstance(subval, str):
                        result[(section, (key, subkey))] = subval
            elif isinstance(value, str):
                result[(section, (key,))] = value
    return result

def set_nested(values, section, path, value):
    target = values.setdefault(section, {})
    if len(path) == 1:
        target[path[0]] = value
    else:
        target.setdefault(path[0], {})[path[1]] = value

# Replace comment contents with spaces without disturbing offsets.
COMMENT = re.compile(r'<!--.*?-->', re.S)
TAG = re.compile(r'<(/?)([A-Za-z_][\w:.-]*)(?:\s[^<>]*?)?\s*(/?)>', re.S)

def masked(text):
    return COMMENT.sub(lambda m: re.sub(r'[^\n]', ' ', m.group()), text)

def find_elements(text, name, start=0, end=None):
    """Find matching XML element ranges, ignoring comments; supports nested tags."""
    if end is None:
        end = len(text)
    clean = masked(text)
    stack = []
    found = []
    for m in TAG.finditer(clean, start, end):
        closing, tag, selfclosing = m.groups()
        if closing:
            if not stack or stack[-1][0] != tag:
                raise ValueError('Malformed XML around ' + tag)
            open_tag, begin, open_end, depth = stack.pop()
            if tag == name:
                found.append((begin, m.end(), open_end, m.start(), depth))
        elif not selfclosing:
            stack.append((tag, m.start(), m.end(), len(stack)))
        elif tag == name:
            found.append((m.start(), m.end(), m.end(), m.end(), len(stack)))
    return found

def replace_leaf(text, parent, child, value):
    """Update existing leaf value or append leaf; preserve all unrelated bytes."""
    spans = find_elements(text, parent)
    if len(spans) != 1:
        raise ValueError(f'Expected exactly one {parent}, found {len(spans)}')
    a, b, content_start, content_end, _ = spans[0]
    children = [x for x in find_elements(text[content_start:content_end], child) if x[4] == 0]
    if len(children) > 1:
        raise ValueError(f'Multiple {child} elements inside {parent}')
    if children:
        ca, cb, ci, cj, _ = children[0]
        if ci == cj:
            raise ValueError('Self-closing leaf not supported: ' + child)
        lo, hi = content_start + ci, content_start + cj
        old = text[lo:hi]
        if '<' in masked(old):
            raise ValueError(f'{child} contains nested elements')
        # Keep whitespace around the value; comments inside leaf are left untouched.
        matches = list(re.finditer(r'(?s)(<!--.*?-->|[^<]+)', old))
        visible = [m for m in matches if not m.group().startswith('<!--') and m.group().strip()]
        if len(visible) != 1:
            raise ValueError(f'Cannot safely edit {child} with mixed content')
        m = visible[0]
        segment = m.group()
        updated = segment[:len(segment)-len(segment.lstrip())] + value + segment[len(segment.rstrip()):]
        return text[:lo+m.start()] + updated + text[lo+m.end():]
    indent_match = re.search(r'\n([ \t]*)<', text[content_start:content_end])
    indent = indent_match.group(1) if indent_match else '    '
    insertion = f'\n{indent}<{child}>{value}</{child}>'
    return text[:content_end] + insertion + text[content_end:]

def update_style(text, section, property_path, value):
    spans = find_elements(text, section)
    if len(spans) != 1:
        raise ValueError(f'Expected exactly one {section}, found {len(spans)}')
    a, b, cs, ce, _ = spans[0]
    part = text[cs:ce]
    if len(property_path) == 1:
        new = replace_leaf('<root>' + part + '</root>', 'root', property_path[0], value)[6:-7]
    else:
        group, leaf = property_path
        group_spans = [x for x in find_elements(part, group) if x[4] == 0]
        if len(group_spans) != 1:
            raise ValueError(f'Expected one {group} in {section}')
        new = replace_leaf('<root>' + part + '</root>', group, leaf, value)[6:-7]
    return text[:cs] + new + text[ce:]

def get_value(text, section, path):
    try:
        root = ET.fromstring(text)
        section_element = root.find(section)
        if section_element is None:
            return None
        node = section_element
        for name in path:
            node = node.find(name)
            if node is None:
                return None
        return (node.text or '').strip()
    except ET.ParseError:
        return None

def save_atomic(path, data):
    mode = stat.S_IMODE(path.stat().st_mode)
    fd, tempname = tempfile.mkstemp(prefix='.' + path.name + '.', dir=path.parent)
    try:
        with os.fdopen(fd, 'wb') as out:
            out.write(data)
            out.flush()
            os.fsync(out.fileno())
        os.chmod(tempname, mode)
        os.replace(tempname, path)
    finally:
        if os.path.exists(tempname):
            os.unlink(tempname)

def start_button(text):
    """Locate the unambiguous root-menu TrayButton (root:N) outside comments."""
    clean = masked(text)
    candidates = []
    for a, b, cs, ce, depth in find_elements(text, 'TrayButton'):
        if re.fullmatch(r'\s*root:\d+\s*', clean[cs:ce]):
            candidates.append((a, b, cs, ce))
    if len(candidates) > 1:
        raise ValueError('Multiple root-menu TrayButtons: cannot choose one safely.')
    return candidates[0] if candidates else None


def start_attributes(text):
    span = start_button(text)
    if not span:
        return None
    opening = text[span[0]:span[2]]
    return {key: value for key, quote, value in re.findall(r'([\w-]+)\s*=\s*(["\'])(.*?)\2', opening, re.S)}


def update_start_attribute(text, key, value):
    span = start_button(text)
    if not span:
        raise ValueError('No root-menu TrayButton found.')
    a, b, cs, ce = span
    opening = text[a:cs]
    match = re.search(r'(?<![\w-])' + re.escape(key) + r'\s*=\s*(["\'])(.*?)\1', opening, re.S)
    from xml.sax.saxutils import escape
    safe = escape(value, {'"': '&quot;', "'": '&apos;'})
    if match:
        opening = opening[:match.start(2)] + safe + opening[match.end(2):]
    else:
        opening = opening[:-1] + ' ' + key + '= "' + safe + '">' if opening.endswith('>') else opening
    return text[:a] + opening + text[cs:]


def title_button_images(text, config_path):
    """Read JWM title-button image paths, without changing their configuration."""
    try:
        root = ET.fromstring(text)
        style = root.find('WindowStyle')
        if style is None:
            return {}
        result = {}
        for key in ('ButtonClose', 'ButtonMax', 'ButtonMin', 'ButtonMaxActive',
                    'ButtonCloseActive', 'ButtonMinActive'):
            node = style.find(key)
            if node is not None and (node.text or '').strip():
                name = (node.text or '').strip()
                file = Path(os.path.expandvars(os.path.expanduser(name)))
                candidates = [file] if file.is_absolute() else [config_path.parent / file, Path.home() / '.jwm' / file]
                for candidate in candidates:
                    if candidate.is_file():
                        result[key] = str(candidate)
                        break
        return result
    except (ET.ParseError, OSError):
        return {}


        label = Gtk.Label()
        label.set_markup('<b>Volume principal</b>')
        label.set_xalign(0)
        content.pack_start(label, False, False, 0)
        self.mixer_master = VolumeRow(self.args.max_volume, self.set_master_volume,
                                      self.set_master_mute)
        content.pack_start(self.mixer_master.root, False, False, 0)

        label = Gtk.Label()

#!/usr/bin/env python3
"""Compact PulseAudio/PipeWire tray mixer for GTK 3 / X11.

Works with GTK3 StatusIcon-capable trays (including JWM).
"""
import argparse
import logging
import os
import threading
import time

import gi
gi.require_version('Gtk', '3.0')
gi.require_version('Gdk', '3.0')
from gi.repository import Gdk, GLib, Gtk
import pulsectl

LOG = logging.getLogger('jwm_audio')


def percentage(obj):
    return round(obj.volume.value_flat * 100)


def friendly(obj):
    return getattr(obj, 'description', None) or getattr(obj, 'name', '?')


def make_button(symbol, tooltip, callback):
    button = Gtk.Button()
    button.set_image(Gtk.Image.new_from_icon_name(symbol, Gtk.IconSize.BUTTON))
    button.set_tooltip_text(tooltip)
    button.set_relief(Gtk.ReliefStyle.NONE)
    button.connect('clicked', callback)
    return button


class VolumeRow:
    """A horizontal volume row, keeping scale stable during live event updates."""

    def __init__(self, max_volume, on_volume, on_mute, icon='audio-volume-high-symbolic'):
        self.on_volume = on_volume
        self.on_mute = on_mute
        self.mute = False
        self.dragging = False
        self.root = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        self.mute_button = make_button(icon, 'Silenciar / ativar', self._mute)
        self.root.pack_start(self.mute_button, False, False, 0)
        self.scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, max_volume, 1)
        self.scale.set_draw_value(False)
        if max_volume > 100:
            self.scale.add_mark(100, Gtk.PositionType.BOTTOM, '100%')
        self.scale.set_size_request(140, -1)
        self.scale.connect('value-changed', self._volume)
        self.scale.connect('button-press-event', self._press)
        self.scale.connect('button-release-event', self._release)
        self.scale.connect('key-press-event', self._press)
        self.scale.connect('key-release-event', self._release)
        self.root.pack_start(self.scale, True, True, 0)
        self.label = Gtk.Label(label='0%')
        self.label.set_width_chars(5)
        self.label.set_xalign(1)
        self.root.pack_start(self.label, False, False, 0)

    def _press(self, *args):
        self.dragging = True
        return False

    def _release(self, *args):
        self.dragging = False
        return False

    def _volume(self, scale):
        if not getattr(self, 'updating', False):
            self.on_volume(scale.get_value() / 100.0)

    def _mute(self, *_):
        self.on_mute(not self.mute)

    def update(self, obj, is_mic=False):
        if obj is None:
            self.root.set_sensitive(False)
            self.label.set_text('—')
            return
        self.root.set_sensitive(True)
        self.mute = bool(obj.mute)
        value = percentage(obj)
        if not self.dragging:
            self.updating = True
            try:
                self.scale.set_value(min(value, self.scale.get_adjustment().get_upper()))
            finally:
                self.updating = False
        self.label.set_text(f'{value}%')
        context = self.scale.get_style_context()
        (context.add_class if value > 100 else context.remove_class)('amplified')
        symbol = 'microphone-sensitivity-muted-symbolic' if is_mic and self.mute else (
            'audio-volume-muted-symbolic' if self.mute else (
                'microphone-sensitivity-high-symbolic' if is_mic else (
                    'audio-volume-low-symbolic' if value <= 33 else
                    'audio-volume-medium-symbolic' if value <= 66 else
                    'audio-volume-high-symbolic')))
        self.mute_button.set_image(Gtk.Image.new_from_icon_name(symbol, Gtk.IconSize.BUTTON))
        self.mute_button.set_tooltip_text('Ativar' if self.mute else 'Silenciar')


class AudioTray:
    def __init__(self, args):
        self.args = args
        self.pulse = pulsectl.Pulse('jwm_audio_control')
        self.closed = threading.Event()
        self.refresh_pending = False
        self.sinks = {}
        self.sources = {}
        self.streams = {}
        self.server = None
        self.sink = None
        self.source = None
        self.stream_rows = {}
        self._build_ui()
        self.refresh()
        self.worker = threading.Thread(target=self._listen, daemon=True)
        self.worker.start()

    def _build_ui(self):

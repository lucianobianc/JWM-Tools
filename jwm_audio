        self.mixer.set_size_request(360, 320)
        self.mixer.connect('delete-event', lambda *_: (self.mixer.hide(), True)[1])
        self.mixer.connect('key-press-event', self.on_mixer_key)

        content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        content.set_border_width(12)

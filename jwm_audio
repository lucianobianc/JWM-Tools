        self.tray.connect('popup-menu', self.context_menu)
        self.tray.connect('scroll-event', self.on_scroll)

        # A compact, fixed-size popup. It never shares geometry with the mixer.
        self.popup = Gtk.Window(type=Gtk.WindowType.TOPLEVEL)
        self.popup.set_title('jwm_audio')
        self.popup.set_decorated(False)
        self.popup.set_resizable(False)
        self.popup.set_skip_taskbar_hint(True)
        self.popup.set_skip_pager_hint(True)
        self.popup.set_type_hint(Gdk.WindowTypeHint.UTILITY)
        self.popup.set_position(Gtk.WindowPosition.NONE)
        self.popup.set_border_width(12)
        self.popup.connect('focus-out-event', self.on_focus_out)
        self.popup.connect('key-press-event', self.on_key)
        self.popup.connect('delete-event', lambda *_: (self.popup.hide(), True)[1])

        primary = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        primary.set_size_request(185, -1)
        self.popup.add(primary)

        title = Gtk.Label()
        title.set_markup('<b>Volume</b>')
        title.set_xalign(0)
        primary.pack_start(title, False, False, 0)

        vertical_area = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=9)
        vertical_area.set_halign(Gtk.Align.CENTER)
        primary.pack_start(vertical_area, True, True, 0)
        self.vertical = Gtk.Scale.new_with_range(Gtk.Orientation.VERTICAL, 0, self.args.max_volume, 1)
        self.vertical.set_inverted(True)
        self.vertical.set_draw_value(False)
        if self.args.max_volume > 100:
            self.vertical.add_mark(100, Gtk.PositionType.LEFT, '100%')
        self.vertical.set_size_request(46, 156)
        self.vertical.connect('value-changed', self.on_master_change)
        self.master_dragging = False
        self.vertical.connect('button-press-event', self.master_press)
        self.vertical.connect('button-release-event', self.master_release)
        self.vertical.connect('key-press-event', self.master_press)
        self.vertical.connect('key-release-event', self.master_release)
        vertical_area.pack_start(self.vertical, False, False, 0)
        side = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        side.set_valign(Gtk.Align.CENTER)
        vertical_area.pack_start(side, False, False, 0)
        self.value_label = Gtk.Label(label='—')
        side.pack_start(self.value_label, False, False, 0)
        self.master_mute = make_button('audio-volume-high-symbolic', 'Mute', self.toggle_master_mute)
        side.pack_start(self.master_mute, False, False, 0)

        self.out_label = Gtk.Label(label='Sem saída')
        self.out_label.set_line_wrap(True)
        self.out_label.set_max_width_chars(24)
        self.out_label.set_ellipsize(3)
        primary.pack_start(self.out_label, False, False, 0)

        mixer_button = Gtk.Button(label='Abrir mixer…')
        mixer_button.connect('clicked', self.open_mixer)
        primary.pack_start(mixer_button, False, False, 0)

        # A normal top-level window, managed independently by JWM.
        self.mixer = Gtk.Window(type=Gtk.WindowType.TOPLEVEL)

        self.stream_scroller.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        self.stream_scroller.set_min_content_height(230)
        self.stream_scroller.set_vexpand(True)
        content.pack_start(self.stream_scroller, True, True, 0)
        self.stream_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        self.stream_box.set_border_width(4)
        self.stream_scroller.add(self.stream_box)

        label = Gtk.Label()
        label.set_markup('<b>Saída</b>')
        label.set_xalign(0)
        content.pack_start(label, False, False, 0)
        self.output_combo = Gtk.ComboBoxText()
        self.output_combo.connect('changed', self.select_output)
        content.pack_start(self.output_combo, False, False, 0)
        self.output_port = Gtk.ComboBoxText()
        self.output_port.connect('changed', self.select_output_port)
        content.pack_start(self.output_port, False, False, 0)

        label = Gtk.Label()
        label.set_markup('<b>Microfone</b>')
        label.set_xalign(0)
        content.pack_start(label, False, False, 0)
        self.input_combo = Gtk.ComboBoxText()
        self.input_combo.connect('changed', self.select_input)
        content.pack_start(self.input_combo, False, False, 0)
        self.input_port = Gtk.ComboBoxText()
        self.input_port.connect('changed', self.select_input_port)
        content.pack_start(self.input_port, False, False, 0)
        self.mic_row = VolumeRow(self.args.max_volume, self.set_mic_volume, self.set_mic_mute)
        content.pack_start(self.mic_row.root, False, False, 0)

        css = Gtk.CssProvider()
        css.load_from_data(b"""
            scale.amplified highlight { background-color: #c87536; }
            /* Let the mixer window's theme background show through the list. */
            scrolledwindow.jwm_audio_applications,
            scrolledwindow.jwm_audio_applications viewport {
                background-color: transparent;
                background-image: none;
            }
        """)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        # Realize the widget hierarchy once; the windows remain hidden until requested.
        self.popup.show_all()
        self.popup.hide()
        self.mixer.show_all()
        self.mixer.hide()

    def call(self, func, *args):
        try:
            return func(*args)
        except (pulsectl.PulseError, OSError) as exc:
            LOG.warning('PulseAudio: %s', exc)
            self.schedule_refresh()
            return None

    def _listen(self):
        """Dedicated connection: pulsectl objects must not be shared across threads."""
        while not self.closed.is_set():
            try:
                with pulsectl.Pulse('jwm_audio_events') as listener:
                    listener.event_mask_set('all')
                    listener.event_callback_set(lambda _: GLib.idle_add(self.schedule_refresh))
                    while not self.closed.is_set():
                        listener.event_listen(timeout=2)
            except (pulsectl.PulseError, OSError) as exc:
                LOG.warning('PulseAudio event connection: %s', exc)
                time.sleep(2)

    def schedule_refresh(self):
        if not self.refresh_pending and not self.closed.is_set():
            self.refresh_pending = True
            GLib.timeout_add(90, self._refresh_once)
        return False

    def _refresh_once(self):
        self.refresh_pending = False
        self.refresh()
        return False

    def refresh(self):
        try:
            self.server = self.pulse.server_info()
            self.sinks = {s.name: s for s in self.pulse.sink_list()}
            self.sources = {s.name: s for s in self.pulse.source_list() if not s.name.endswith('.monitor')}
            self.streams = {s.index: s for s in self.pulse.sink_input_list()}
        except (pulsectl.PulseError, OSError) as exc:
            LOG.warning('Could not update audio state: %s', exc)
            self.tray.set_tooltip_text('PulseAudio indisponível')
            return
        self.sink = self.sinks.get(self.server.default_sink_name)
        self.source = self.sources.get(self.server.default_source_name)
        if self.sink:
            vol = percentage(self.sink)
            muted = bool(self.sink.mute)
            name = friendly(self.sink)
            self.tray.set_from_icon_name(self.volume_icon(vol, muted))
            self.tray.set_tooltip_text(f'{name}: {vol}%'+ (' (mudo)' if muted else ''))
            self.out_label.set_text(name)
            self.value_label.set_text(f'{vol}%')
            context = self.vertical.get_style_context()
            (context.add_class if vol > 100 else context.remove_class)('amplified')
            self.master_mute.set_image(Gtk.Image.new_from_icon_name(
                self.volume_icon(vol, muted, symbolic=True), Gtk.IconSize.BUTTON))
            if not self.master_dragging:
                self.master_updating = True
                self.vertical.set_value(min(vol, self.args.max_volume))
                self.master_updating = False
        else:
            self.tray.set_from_icon_name('audio-volume-muted')
            self.tray.set_tooltip_text('Nenhuma saída de áudio')
            self.out_label.set_text('Sem saída')
            self.value_label.set_text('—')
        self.vertical.set_sensitive(bool(self.sink))
        self.master_mute.set_sensitive(bool(self.sink))
        self.mixer_master.update(self.sink)
        if self.mixer.get_visible():
            self.refresh_details()

    @staticmethod
    def volume_icon(vol, mute, symbolic=False):
        if mute or vol <= 0:
            icon = 'audio-volume-muted'
        elif vol <= 33:
            icon = 'audio-volume-low'
        elif vol <= 66:
            icon = 'audio-volume-medium'
        else:
            icon = 'audio-volume-high'
        return icon + ('-symbolic' if symbolic else '')

    def current_sink(self):
        return self.sink

    def current_source(self):
        return self.source

    def on_master_change(self, widget):
        if getattr(self, 'master_updating', False):
            return
        sink = self.current_sink()
        if sink:
            self.call(self.pulse.volume_set_all_chans, sink, widget.get_value() / 100)
            self.schedule_refresh()

    def master_press(self, *_):
        self.master_dragging = True
        return False

    def master_release(self, *_):
        self.master_dragging = False
        return False

    def toggle_master_mute(self, *_):
        if self.sink:
            self.call(self.pulse.mute, self.sink, not self.sink.mute)
            self.schedule_refresh()

    def on_tray_click(self, _icon, event):
        if event.button == 2:
            self.toggle_master_mute()
            return True
        # Right click is handled by popup-menu; left click by activate.
        return False

    def on_scroll(self, _icon, event):
        if not self.sink:
            return False
        change = self.args.volume_step / 100
        if event.direction == Gdk.ScrollDirection.UP:
            delta = change
        elif event.direction == Gdk.ScrollDirection.DOWN:
            delta = -change
        elif event.direction == Gdk.ScrollDirection.SMOOTH:
            _ok, dx, dy = event.get_scroll_deltas()
            delta = -dy * change
        else:
            return False
        new = max(0, min(self.args.max_volume / 100, self.sink.volume.value_flat + delta))
        self.call(self.pulse.volume_set_all_chans, self.sink, new)
        self.schedule_refresh()
        return True

    def toggle_popup(self):
        if self.popup.get_visible():
            self.popup.hide()
            return
        self.refresh()
        self.position_popup()
        self.popup.show_all()
        # Geometry becomes final after mapping; compensate once, not after mixer changes.
        GLib.idle_add(self.position_popup)
        self.popup.present()

    def position_popup(self):
        if not self.tray.is_embedded():
            return False
        geom = self.tray.get_geometry()
        if not geom or not geom[0]:
            return False
        # PyGObject GTK 3 returns (success, screen, rectangle, orientation).
        # Some older bindings expose only (screen, rectangle, orientation).
        if len(geom) == 4:
            ok, screen, rect, _orientation = geom
            if not ok:
                return False
        elif len(geom) == 3:
            screen, rect, _orientation = geom
        else:
            return False
        if screen is None or rect is None:
            return False
        monitor_id = screen.get_monitor_at_point(
            rect.x + rect.width // 2, rect.y + rect.height // 2)
        work = screen.get_monitor_workarea(monitor_id)
        # Preferred size is available even when the popup is currently hidden.
        _minimum, natural = self.popup.get_preferred_size()
        width, height = max(1, natural.width), max(1, natural.height)
        margin = 6
        x = rect.x + (rect.width - width) // 2
        if rect.y >= work.y + work.height // 2:
            y = rect.y - height - margin
        else:
            y = rect.y + rect.height + margin
        x = max(work.x + margin, min(x, work.x + work.width - width - margin))
        y = max(work.y + margin, min(y, work.y + work.height - height - margin))
        self.popup.move(x, y)
        return False

    def on_focus_out(self, *_):
        # Only the small popup closes when it loses focus; the mixer is a
        # normal, persistent window and is not affected.
        GLib.timeout_add(120, self.hide_if_unfocused)
        return False

    def hide_if_unfocused(self):
        if self.popup.get_visible() and not self.popup.is_active():
            self.popup.hide()
        return False

    def on_key(self, _window, event):
        if event.keyval == Gdk.KEY_Escape:
            self.popup.hide()
            return True
        return False

    def on_mixer_key(self, _window, event):
        if event.keyval == Gdk.KEY_Escape:
            self.mixer.hide()
            return True
        return False

    def set_master_volume(self, value):
        if self.sink:
            self.call(self.pulse.volume_set_all_chans, self.sink, value)
            self.schedule_refresh()

    def set_master_mute(self, mute):
        if self.sink:
            self.call(self.pulse.mute, self.sink, mute)
            self.schedule_refresh()

    def update_combo(self, combo, items, selected):
        old_items = getattr(combo, '_audio_items', None)
        current_items = tuple((name, label) for name, label in items)
        if old_items == current_items and combo.get_active_id() == selected:
            return
        self.combo_lock = True
        try:
            combo.remove_all()
            for ident, label in items:
                combo.append(ident, label)
            combo.set_active_id(selected)
            combo._audio_items = current_items
            combo.set_sensitive(bool(items))
            combo.set_visible(bool(items))
        finally:
            self.combo_lock = False

    def refresh_details(self):
        self.update_combo(self.output_combo,
                          [(s.name, friendly(s)) for s in self.sinks.values()],
                          self.sink.name if self.sink else None)
        self.update_combo(self.input_combo,
                          [(s.name, friendly(s)) for s in self.sources.values()],
                          self.source.name if self.source else None)
        self.update_ports(self.output_port, self.sink)
        self.update_ports(self.input_port, self.source)
        self.mic_row.update(self.source, is_mic=True)

        existing = set(self.stream_rows)
        incoming = set(self.streams)
        for sid in existing - incoming:
            self.stream_rows.pop(sid)['root'].destroy()
        for sid in incoming - existing:
            stream = self.streams[sid]
            block = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
            separator = Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL)
            block.pack_start(separator, False, False, 3)
            header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
            app_icon = Gtk.Image.new_from_icon_name('audio-x-generic', Gtk.IconSize.DND)
            app_icon.set_pixel_size(24)
            header.pack_start(app_icon, False, False, 0)
            name = Gtk.Label(label=self.stream_name(stream))
            name.set_xalign(0)
            name.set_hexpand(True)
            name.set_ellipsize(3)
            header.pack_start(name, True, True, 0)
            block.pack_start(header, False, False, 0)
            row = VolumeRow(self.args.max_volume,
                            lambda value, idx=sid: self.set_stream_volume(idx, value),
                            lambda mute, idx=sid: self.set_stream_mute(idx, mute))
            block.pack_start(row.root, False, False, 0)
            route = Gtk.ComboBoxText()
            route.connect('changed', lambda widget, idx=sid: self.route_stream(idx, widget))
            block.pack_start(route, False, False, 0)
            self.stream_box.pack_start(block, False, False, 0)
            self.stream_rows[sid] = dict(root=block, separator=separator, name=name, icon=app_icon, row=row, route=route)
            block.show_all()
        # Follow the surviving row order when streams appear or disappear.
        for position, widgets in enumerate(self.stream_rows.values()):
            widgets['separator'].set_visible(position > 0)
        for sid, stream in self.streams.items():
            widgets = self.stream_rows[sid]
            widgets['name'].set_text(self.stream_name(stream))
            icon_name = self.stream_icon(stream)
            if widgets.get('icon_name') != icon_name:
                widgets['icon'].set_from_icon_name(icon_name, Gtk.IconSize.DND)
                widgets['icon'].set_pixel_size(24)
                widgets['icon_name'] = icon_name
            widgets['row'].update(stream)
            self.update_combo(widgets['route'],
                              [(s.name, '→ ' + friendly(s)) for s in self.sinks.values()],
                              next((s.name for s in self.sinks.values() if s.index == stream.sink), None))
        if not self.streams:
            if not hasattr(self, 'no_streams'):
                self.no_streams = Gtk.Label(label='Nenhum aplicativo reproduzindo áudio')
                self.no_streams.set_line_wrap(True)
                self.stream_box.pack_start(self.no_streams, False, False, 0)
            self.no_streams.show()
        elif hasattr(self, 'no_streams'):
            self.no_streams.hide()

    @staticmethod
    def stream_name(stream):
        props = stream.proplist or {}
        return props.get('application.name') or stream.name or 'Aplicativo'

    @staticmethod
    def stream_icon(stream):
        """Resolve an app icon using PulseAudio metadata and the GTK icon theme."""
        props = stream.proplist or {}
        theme = Gtk.IconTheme.get_default()
        candidates = (
            props.get('application.icon_name'),
            props.get('application.id'),
            os.path.basename(props.get('application.process.binary') or ''),
        )
        for candidate in candidates:
            if not candidate:
                continue
            # Flatpak IDs may use mixed case; theme names may be lower-case.
            for name in (candidate, candidate.lower()):
                if theme.has_icon(name):
                    return name
        return 'audio-x-generic'

    def update_ports(self, combo, device):
        ports = getattr(device, 'port_list', []) if device else []
        active = getattr(getattr(device, 'port_active', None), 'name', None) if device else None
        self.update_combo(combo, [(port.name, friendly(port)) for port in ports], active)
        combo.set_visible(len(ports) > 1)

    def select_output(self, combo):
        if self.combo_lock:
            return
        sink = self.sinks.get(combo.get_active_id())
        if sink:
            self.call(self.pulse.default_set, sink)
            self.schedule_refresh()

    def select_input(self, combo):
        if self.combo_lock:
            return
        source = self.sources.get(combo.get_active_id())
        if source:
            self.call(self.pulse.default_set, source)
            self.schedule_refresh()

    def select_output_port(self, combo):
        if not self.combo_lock and self.sink and combo.get_active_id():
            self.call(self.pulse.sink_port_set, self.sink, combo.get_active_id())
            self.schedule_refresh()

    def select_input_port(self, combo):
        if not self.combo_lock and self.source and combo.get_active_id():
            self.call(self.pulse.source_port_set, self.source, combo.get_active_id())
            self.schedule_refresh()

    def set_mic_volume(self, value):
        if self.source:
            self.call(self.pulse.volume_set_all_chans, self.source, value)
            self.schedule_refresh()

    def set_mic_mute(self, mute):
        if self.source:
            self.call(self.pulse.mute, self.source, mute)
            self.schedule_refresh()

    def set_stream_volume(self, sid, value):
        stream = self.streams.get(sid)
        if stream:
            self.call(self.pulse.volume_set_all_chans, stream, value)
            self.schedule_refresh()

    def set_stream_mute(self, sid, mute):
        stream = self.streams.get(sid)
        if stream:
            self.call(self.pulse.mute, stream, mute)
            self.schedule_refresh()

    def route_stream(self, sid, combo):
        if self.combo_lock or not combo.get_active_id():
            return
        stream = self.streams.get(sid)
        sink = self.sinks.get(combo.get_active_id())
        if stream and sink and stream.sink != sink.index:
            self.call(self.pulse.sink_input_move, stream.index, sink.index)
            self.schedule_refresh()

    def context_menu(self, _icon, button, timestamp):
        menu = Gtk.Menu()
        show = Gtk.MenuItem(label='Abrir mixer')
        show.connect('activate', lambda *_: self.open_mixer())
        menu.append(show)
        quit_item = Gtk.MenuItem(label='Sair')
        quit_item.connect('activate', self.quit)
        menu.append(quit_item)
        menu.show_all()
        menu.popup(None, None, Gtk.StatusIcon.position_menu, self.tray, button, timestamp)

    def open_mixer(self, *_):
        self.popup.hide()
        self.refresh()
        if not self.mixer.get_visible():
            self.mixer.show_all()
        # Reapply visibility of single-port selectors after show_all().
        self.refresh_details()
        self.mixer.present()

    def quit(self, *_):
        self.closed.set()
        self.popup.destroy()
        self.mixer.destroy()
        self.tray.set_visible(False)
        self.pulse.close()
        Gtk.main_quit()


def parse_args():
    from jwm_tools import __version__
    ap = argparse.ArgumentParser(description='GTK3 systray mixer for PulseAudio on X11')
    ap.add_argument('--version', action='version', version='jwm_audio ' + __version__)
    ap.add_argument('--max-volume', type=int, default=150, help='Maximum volume percent (default 150)')
    ap.add_argument('--volume-step', type=int, default=5, help='Mouse-wheel volume increment (default 5)')
    ap.add_argument('--dark-mode', action='store_true', help='Prefer a dark GTK theme')
    ap.add_argument('--light-mode', action='store_true', help='Prefer a light GTK theme')
    args = ap.parse_args()
    if not 100 <= args.max_volume <= 200:
        ap.error('--max-volume must be 100..200')
    if not 1 <= args.volume_step <= 50:
        ap.error('--volume-step must be 1..50')
    if args.dark_mode and args.light_mode:
        ap.error('Choose one of --dark-mode / --light-mode')
    return args


def main():
    logging.basicConfig(level=logging.WARNING, format='%(name)s: %(message)s')
    args = parse_args()
    Gtk.Settings.get_default().set_property('gtk-application-prefer-dark-theme', args.dark_mode if args.dark_mode or args.light_mode else False)
    try:
        app = AudioTray(args)
    except (pulsectl.PulseError, OSError) as exc:
        raise SystemExit(f'Cannot connect to PulseAudio: {exc}')
    Gtk.main()


if __name__ == '__main__':
    main()

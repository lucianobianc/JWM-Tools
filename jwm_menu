#!/usr/bin/env python3
"""Generate or edit JWM application menus."""
import argparse
from pathlib import Path
from jwm_tools import __version__


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--version", action="version", version="jwm_menu " + __version__
    )
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument(
        "--edit", action="store_true", help="open the graphical menu editor"
    )
    mode.add_argument(
        "--generate",
        action="store_true",
        help="generate ~/.jwm-menu without opening the editor",
    )
    parser.add_argument(
        "configuration",
        nargs="?",
        type=Path,
        help="JWM configuration or menu file to edit (implies --edit)",
    )
    args = parser.parse_args()
    if args.configuration and args.generate:
        parser.error("A configuration path cannot be used with --generate.")
    if not args.generate:
        from jwm_tools.menu.editor import main as edit

        default = Path.home() / ".jwmrc"
        edit(
            args.configuration
            or (default if default.exists() else Path.home() / ".jwm-menu")
        )
    else:
        from jwm_tools.menu.generator import main as generate

        generate()


if __name__ == "__main__":
    main()
